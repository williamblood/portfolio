# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Recommended: Supabase, Neon, Railway, or PlanetScale (MySQL with minor schema changes)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── CJ Dropshipping ──────────────────────────────────────────────────────────
# Sign up at: https://app.cjdropshipping.com/register.html
CJ_EMAIL="your@email.com"
CJ_PASSWORD="your_cj_password"

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail: use App Password (not your account password)
# Recommended services: Resend, Postmark, AWS SES
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your@gmail.com"
SMTP_PASS="your_app_password"

# ─── Store Branding ───────────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="LUXE"
STORE_NAME="LUXE"
STORE_EMAIL="hello@luxestore.com"
NEXT_PUBLIC_STORE_URL="https://luxestore.com"

# ─── Security ─────────────────────────────────────────────────────────────────
# Random secret for cron job authentication
CRON_SECRET="generate_a_random_32char_string_here"

# Admin panel token (keep this very secret)
ADMIN_SECRET="generate_another_random_32char_string"
NEXT_PUBLIC_ADMIN_TOKEN="same_as_ADMIN_SECRET"

# ─── Pricing ──────────────────────────────────────────────────────────────────
# Default: 1.3 = 30% markup
MARKUP_RATE="1.3"
